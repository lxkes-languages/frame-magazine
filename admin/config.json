{
  "backend": {
    "name": "github",
    "repo": "lxkes-languages/frame-magazine",
    "branch": "main",
    "auth_endpoint": "auth",
    "site_domain": "lxkes-languages.github.io"
  },
  "site_url": "https://lxkes-languages.github.io/frame-magazine/",
  "display_url": "https://lxkes-languages.github.io/frame-magazine/",
  "logo_url": "",
  "publish_mode": "editorial_workflow",
  "media_folder": "uploads",
  "public_folder": "/frame-magazine/uploads",
  "collections": [
    {
      "name": "stories",
      "label": "Stories",
      "label_singular": "Story",
      "description": "Save a draft, review it in Workflow, then choose Publish when it is ready. Published stories appear in Fresh perspectives and Latest stories.",
      "folder": "_data/stories",
      "create": true,
      "extension": "json",
      "format": "json",
      "slug": "{{slug}}",
      "summary": "{{title}} — {{category}}",
      "sortable_fields": [
        "date",
        "title"
      ],
      "fields": [
        {
          "label": "Title",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "Category",
          "name": "category",
          "widget": "select",
          "options": [
            "Art & Culture",
            "Photography",
            "Journal",
            "Book Reviews"
          ],
          "default": "Journal"
        },
        {
          "label": "Date",
          "name": "date",
          "widget": "datetime",
          "date_format": "YYYY-MM-DD",
          "time_format": false,
          "format": "YYYY-MM-DD"
        },
        {
          "label": "Short introduction",
          "name": "description",
          "widget": "text"
        },
        {
          "label": "Cover photograph",
          "name": "image",
          "widget": "image",
          "allow_multiple": false,
          "hint": "Upload a JPG, PNG or WebP. Optimise large photographs first; aim for less than 10 MB."
        },
        {
          "label": "Image description",
          "name": "alt",
          "widget": "string",
          "hint": "Describe the photograph for readers using assistive technology."
        },
        {
          "label": "Photographer / image credit",
          "name": "credit",
          "widget": "string",
          "required": false
        },
        {
          "label": "Reading time in minutes",
          "name": "minutes",
          "widget": "number",
          "value_type": "int",
          "min": 1,
          "max": 120,
          "default": 3
        },
        {
          "label": "Paragraphs",
          "name": "text",
          "widget": "list",
          "min": 1,
          "field": {
            "label": "Paragraph",
            "name": "paragraph",
            "widget": "text"
          },
          "hint": "Add one item for each paragraph. Text is displayed as plain text."
        },
        {
          "label": "Photo gallery",
          "name": "gallery",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "label": "Photograph",
              "name": "image",
              "widget": "image",
              "allow_multiple": false
            },
            {
              "label": "Image description",
              "name": "alt",
              "widget": "string"
            },
            {
              "label": "Caption / credit",
              "name": "caption",
              "widget": "string",
              "required": false
            }
          ]
        }
      ]
    },
    {
      "name": "website",
      "label": "Website settings",
      "description": "Edit the magazine page. Save a draft, review it in Workflow, then Publish. The layout stays consistent.",
      "files": [
        {
          "name": "homepage",
          "label": "Homepage and branding",
          "file": "_data/website.json",
          "format": "json",
          "fields": [
            {
              "name": "branding",
              "label": "Branding and colours",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "name",
                  "label": "Magazine name",
                  "widget": "string",
                  "pattern": [
                    "^.{1,20}$",
                    "Use 1–20 characters."
                  ]
                },
                {
                  "name": "logo",
                  "label": "Logo image",
                  "widget": "image",
                  "required": false,
                  "allow_multiple": false,
                  "hint": "Optional. Leave empty to use the magazine name as a text logo."
                },
                {
                  "name": "title",
                  "label": "Browser tab title",
                  "widget": "string"
                },
                {
                  "name": "description",
                  "label": "Site description",
                  "widget": "text"
                },
                {
                  "name": "tagline",
                  "label": "Masthead tagline",
                  "widget": "string"
                },
                {
                  "name": "edition",
                  "label": "Issue / edition",
                  "widget": "string"
                },
                {
                  "name": "header_link",
                  "label": "Header link label",
                  "widget": "string"
                },
                {
                  "name": "nav_note",
                  "label": "Navigation note",
                  "widget": "string"
                },
                {
                  "name": "footer",
                  "label": "Footer description",
                  "widget": "string"
                },
                {
                  "name": "colours",
                  "label": "Colours",
                  "widget": "object",
                  "collapsed": true,
                  "fields": [
                    {
                      "name": "paper",
                      "label": "Background",
                      "widget": "string",
                      "pattern": [
                        "^#[0-9a-fA-F]{6}$",
                        "Use a six-digit colour such as #f3f1eb."
                      ]
                    },
                    {
                      "name": "ink",
                      "label": "Text",
                      "widget": "string",
                      "pattern": [
                        "^#[0-9a-fA-F]{6}$",
                        "Use a six-digit colour such as #f3f1eb."
                      ]
                    },
                    {
                      "name": "accent",
                      "label": "Accent",
                      "widget": "string",
                      "pattern": [
                        "^#[0-9a-fA-F]{6}$",
                        "Use a six-digit colour such as #f3f1eb."
                      ]
                    },
                    {
                      "name": "sage",
                      "label": "Feature background",
                      "widget": "string",
                      "pattern": [
                        "^#[0-9a-fA-F]{6}$",
                        "Use a six-digit colour such as #f3f1eb."
                      ]
                    }
                  ]
                },
                {
                  "name": "socials",
                  "label": "Social links",
                  "widget": "list",
                  "required": false,
                  "max": 8,
                  "fields": [
                    {
                      "name": "label",
                      "label": "Label",
                      "widget": "string"
                    },
                    {
                      "name": "url",
                      "label": "Link",
                      "widget": "string",
                      "pattern": [
                        "^https://",
                        "Use a full HTTPS link."
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "navigation",
              "label": "Navigation labels",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "home",
                  "label": "Home",
                  "widget": "string"
                },
                {
                  "name": "spotlight",
                  "label": "Spotlight",
                  "widget": "string"
                },
                {
                  "name": "art",
                  "label": "Art",
                  "widget": "string"
                },
                {
                  "name": "photography",
                  "label": "Photography",
                  "widget": "string"
                },
                {
                  "name": "journal",
                  "label": "Journal",
                  "widget": "string"
                },
                {
                  "name": "about",
                  "label": "About",
                  "widget": "string"
                },
                {
                  "name": "books",
                  "label": "Book Reviews",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "intro",
              "label": "Homepage introduction",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "headline",
                  "label": "Headline",
                  "widget": "string"
                },
                {
                  "name": "emphasis",
                  "label": "Italic words",
                  "widget": "string",
                  "required": false
                },
                {
                  "name": "description",
                  "label": "Introduction",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "spotlight",
              "label": "Spotlight",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "heading",
                  "label": "Section heading",
                  "widget": "string"
                },
                {
                  "name": "label",
                  "label": "Section label",
                  "widget": "string"
                },
                {
                  "name": "kicker",
                  "label": "Story eyebrow",
                  "widget": "string"
                },
                {
                  "name": "story",
                  "label": "Featured story",
                  "widget": "relation",
                  "collection": "stories",
                  "search_fields": [
                    "title"
                  ],
                  "value_field": "{{slug}}",
                  "display_fields": [
                    "title"
                  ],
                  "required": false,
                  "hint": "Leave empty to feature the newest published story. Publish a new story before selecting it here."
                },
                {
                  "name": "link_label",
                  "label": "Read story link label",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "stories",
              "label": "Fresh perspectives",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "kicker",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "heading",
                  "label": "Section heading",
                  "widget": "string"
                },
                {
                  "name": "description",
                  "label": "Description",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "marquee",
              "label": "Scrolling strip text",
              "widget": "text"
            },
            {
              "name": "feature",
              "label": "Photography feature",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "kicker",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "heading",
                  "label": "Heading before italic words",
                  "widget": "text"
                },
                {
                  "name": "emphasis",
                  "label": "Italic words",
                  "widget": "string",
                  "required": false
                },
                {
                  "name": "ending",
                  "label": "Heading after italic words",
                  "widget": "text",
                  "required": false
                },
                {
                  "name": "description",
                  "label": "Description",
                  "widget": "text"
                },
                {
                  "name": "image",
                  "label": "Feature photograph",
                  "widget": "image",
                  "allow_multiple": false
                },
                {
                  "name": "alt",
                  "label": "Image description",
                  "widget": "string"
                },
                {
                  "name": "caption",
                  "label": "Caption / credit",
                  "widget": "string"
                },
                {
                  "name": "link_label",
                  "label": "Link label",
                  "widget": "string"
                },
                {
                  "name": "story",
                  "label": "Linked story",
                  "widget": "relation",
                  "collection": "stories",
                  "search_fields": [
                    "title"
                  ],
                  "value_field": "{{slug}}",
                  "display_fields": [
                    "title"
                  ],
                  "required": false,
                  "hint": "Leave empty to link to the journal. A removed story also falls back to the journal."
                }
              ]
            },
            {
              "name": "journal",
              "label": "Journal heading",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "kicker",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "heading",
                  "label": "Section heading",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "about",
              "label": "About and contact",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "kicker",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "heading",
                  "label": "Heading before italic words",
                  "widget": "text"
                },
                {
                  "name": "emphasis",
                  "label": "Italic words",
                  "widget": "string",
                  "required": false
                },
                {
                  "name": "ending",
                  "label": "Heading after italic words",
                  "widget": "text",
                  "required": false
                },
                {
                  "name": "description",
                  "label": "About text",
                  "widget": "text"
                },
                {
                  "name": "contact_label",
                  "label": "Contact link label",
                  "widget": "string",
                  "hint": "What readers see, for example Instagram or Follow me on Instagram."
                },
                {
                  "name": "contact_url",
                  "label": "Contact or social link",
                  "widget": "string",
                  "required": false,
                  "hint": "Paste a full HTTPS link, such as your Instagram profile. Leave empty to hide the link.",
                  "pattern": [
                    "^$|^https://[^\\s]+$",
                    "Use a full https:// link or leave empty."
                  ]
                }
              ]
            },
            {
              "name": "visibility",
              "label": "Show or hide sections",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "spotlight",
                  "label": "Spotlight",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "art",
                  "label": "Fresh perspectives",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "photography",
                  "label": "Photography feature",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "journal",
                  "label": "Journal",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "about",
                  "label": "About and contact",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "marquee",
                  "label": "Scrolling strip",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "books",
                  "label": "Book Reviews",
                  "widget": "boolean",
                  "default": true
                }
              ]
            },
            {
              "name": "books",
              "label": "Book reviews section",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "name": "kicker",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "heading",
                  "label": "Section heading",
                  "widget": "string"
                },
                {
                  "name": "description",
                  "label": "Description",
                  "widget": "text"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
